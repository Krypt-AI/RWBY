# Shared backend (Supabase). Set both to share chat, votes, squads, songs and rooms between everyone.
# Leave them empty to run the local demo, where data stays in this browser.
# Both are safe in the browser: row-level security decides what anyone can do.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local demo only: passcode for moderator mode (defaults to "beacon" when unset).
# Client-side only: this is a demo gate, not real security.
VITE_MOD_PASSCODE=beacon
